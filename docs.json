{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Clamly",
  "description": "Documentation for Clamly, the all-in-one study platform with AI quizzes, flashcards, notes, and more.",
  "colors": {
    "primary": "#d45a3a",
    "light": "#e88a6f",
    "dark": "#b84a2e"
  },
  "fonts": {
    "family": "Bricolage Grotesque",
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 600
    },
    "body": {
      "family": "Bricolage Grotesque",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#f2f0e3",
      "dark": "#191919"
    }
  },
  "favicon": "https://media.brand.dev/4c982d40-85e6-401d-84e8-0af20000860e.png",
  "icons": {
    "library": "tabler"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant"
    ]
  },
  "search": {
    "prompt": "Search Clamly docs..."
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "home",
          "href": "/"
        },
        {
          "anchor": "Status",
          "icon": "activity",
          "href": "https://clamly.app/status"
        },
        {
          "anchor": "Support",
          "icon": "lifebuoy",
          "href": "mailto:support@clamly.app"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "default": true,
